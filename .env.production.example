# Copy this file to .env.production and set it to your GitHub repo name,
# with leading and trailing slashes. This must match your repo's name
# exactly (case-sensitive) since GitHub Pages serves project sites at
# https://<username>.github.io/<repo-name>/
#
# Example: if your repo is github.com/yourname/success-squad
# VITE_BASE_PATH=/success-squad/
VITE_BASE_PATH=/your-repo-name/
