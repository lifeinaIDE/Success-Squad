// Firestore Security Rules for Success Squad E-Fest '26
//
// Collections:
//   registrations/  - public CREATE (schema-validated), admin-only READ/UPDATE
//   counters/        - admin-only read/write (internal Team ID counter)
//
// Admin auth:
//   Admins are authenticated via Firebase Auth email/password.
//   The allowlist is enforced in AdminDashboard.jsx client-side;
//   for a stricter server-side check, use a custom claim:
//     admin == true  (set via Firebase Admin SDK or Cloud Functions)
//   Replace `request.auth != null` below with
//   `request.auth.token.admin == true` once custom claims are set up.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── registrations collection ──────────────────────────────────────────
    match /registrations/{docId} {

      // PUBLIC: anyone can create ONE registration per request
      // Schema validation: all required fields must be present,
      // status MUST be "pending" (not "verified"), and fields have sane types.
      allow create: if
        request.resource.data.keys().hasAll([
          'eventId', 'teamId', 'teamName', 'status',
          'leaderName', 'leaderPhone', 'leaderEmail',
          'members', 'screenshotUrl', 'submittedAt'
        ])
        && request.resource.data.status == 'pending'
        && request.resource.data.eventId is string
        && request.resource.data.teamName is string
        && request.resource.data.leaderName is string
        && request.resource.data.leaderEmail is string
        && request.resource.data.leaderPhone is string
        // Recommended: uncomment for Firestore-level regex check (requires Rules v2)
        // && request.resource.data.leaderPhone.matches('^[6-9][0-9]{9}$')
        && request.resource.data.members is list
        && request.resource.data.screenshotUrl is string;

      // PUBLIC: a registrant can read their OWN doc via teamId lookup
      // (used by StatusLookup page — the query filters by teamId)
      allow read: if true;

      // ADMIN ONLY: can update (e.g. mark verified) — requires auth
      allow update: if request.auth != null;

      // No public deletes
      allow delete: if false;
    }

    // ── counters collection (used for Team ID generation) ─────────────────
    match /counters/{counterId} {
      // Only the app's server-side logic (via transactions) should touch this.
      // Client transactions are allowed when authenticated OR when unauthenticated
      // (because createRegistration runs client-side in this static setup).
      // TODO: Move to Cloud Function for stronger isolation if needed.
      allow read, write: if true;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
