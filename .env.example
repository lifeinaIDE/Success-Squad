# Success Squad — Environment Variables
#
# Copy this file to .env.local for local development.
# Add each variable to your Vercel project settings for production.
# NEVER commit your actual .env.local or .env to version control.
# .env and .env.* (except .env.example) are already in .gitignore.

# ── Firebase Project Config ──────────────────────────────────────────────────
# Get these from: Firebase Console → Project Settings → Your Apps → Config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── E-Fest Hidden Hub Slug ───────────────────────────────────────────────────
# A non-guessable token appended to the /fest/ route.
# Generate once with: node -e "console.log(require('crypto').randomBytes(8).toString('hex'))"
# Example output: a3f9d2b1c7e04f82
# The full URL becomes: https://your-domain.com/fest/a3f9d2b1c7e04f82
# Store this value in Vercel env vars. Rotate if the URL leaks.
VITE_FEST_SLUG=

# ── Razorpay Payment Gateway ────────────────────────────────────────────────
# Client-side (Vite) env var for Razorpay Key ID (if using their checkout script directly, 
# though we currently generate the QR securely on the backend)
# VITE_RAZORPAY_KEY_ID=
#
# IMPORTANT: The following secrets MUST ONLY live in Cloud Functions environment config.
# Do NOT add them to Vite .env where they could be bundled into client code.
# Run these commands via Firebase CLI:
# firebase functions:config:set razorpay.id="rzp_test_xxxx" razorpay.secret="yyyy" razorpay.webhook_secret="zzzz"

# ── Base URL (optional, for Vite preview) ───────────────────────────────────
# Leave empty for root deployment. Set to /repo-name/ for GitHub Pages.
# VITE_BASE_URL=/
