# Success Squad — Environment Variables
#
# Copy this file to .env.local for local development.
# Add each variable to Vercel → Project Settings → Environment Variables.
# NEVER commit .env.local or .env to version control.
# They are already in .gitignore.

# ── Supabase Project Config ───────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API
# Both are SAFE for client exposure — RLS policies protect your data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ⛔ NEVER put these in this file — they are Edge Function secrets only:
#    SUPABASE_SERVICE_ROLE_KEY   → supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...
#    RAZORPAY_KEY_SECRET         → supabase secrets set RAZORPAY_KEY_SECRET=...
#    RAZORPAY_WEBHOOK_SECRET     → supabase secrets set RAZORPAY_WEBHOOK_SECRET=...

# ── Razorpay Key ID ────────────────────────────────────────────────────────────
# The Key ID is PUBLISHABLE (like a Stripe publishable key). Safe for client.
# The KEY SECRET must stay server-side (set via `supabase secrets set`).
VITE_RAZORPAY_KEY_ID=

# ── E-Fest Hidden Hub Slug ────────────────────────────────────────────────────
# Generate once:  node -e "console.log(require('crypto').randomBytes(8).toString('hex'))"
# The route becomes: https://your-domain.com/fest/<slug>
# Store in Vercel env vars. Rotate if the URL leaks.
VITE_FEST_SLUG=

# ── Base URL (optional, for Vite preview) ─────────────────────────────────────
# Leave empty for root deployment. Set to /repo-name/ for GitHub Pages.
# VITE_BASE_URL=/
